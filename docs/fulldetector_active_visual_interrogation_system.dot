digraph ASEM_Rev3_Safety_Evidence_Routing {
    graph [
        rankdir=LR,
        bgcolor="#0B1020",
        compound=true,
        splines=true,
        overlap=false,
        concentrate=false,
        pad=0.35,
        nodesep=0.65,
        ranksep=0.95,
        fontname="Segoe UI",
        fontsize=22,
        label="ASEM Rev 3 - Safety and Evidence-Routing Release",
        labelloc=t,
        fontcolor="#EAF2FF"
    ];

    node [
        shape=rect,
        style="rounded,filled",
        fontname="Segoe UI",
        fontsize=12,
        penwidth=1.4,
        color="#6EA8FE",
        fontcolor="#EAF2FF",
        fillcolor="#17233D",
        margin="0.12,0.08"
    ];

    edge [
        color="#A8C7FA",
        fontname="Segoe UI",
        fontsize=10,
        fontcolor="#DDEBFF",
        arrowsize=0.75,
        penwidth=1.2
    ];

    subgraph cluster_classes {
        label="Locked Rev-3 Supported Classes";
        color="#2DD4BF";
        fontcolor="#CCFBF1";
        fillcolor="#071E1A";
        style="rounded,filled";

        class_set [
            label="10-class label order\n1. 1.85mm-M\n2. 1.85mm-F\n3. 2.4mm-M\n4. 2.4mm-F\n5. 2.92mm-M\n6. 2.92mm-F\n7. 3.5mm-M\n8. 3.5mm-F\n9. SMA-F\n10. SMA-M\n\nRead from classifier_labels.json",
            fillcolor="#123524",
            color="#2DD4BF"
        ];
    }

    subgraph cluster_bundle {
        label="Web Model Bundle and Runtime";
        color="#60A5FA";
        fontcolor="#DBEAFE";
        fillcolor="#07182E";
        style="rounded,filled";

        web_bundle [
            label="exports/web bundle\nthresholds.json\nclassifier_labels.json\n*.onnx",
            fillcolor="#1B2E4B",
            color="#60A5FA"
        ];

        ort_runtime [
            label="ONNX Runtime Web\nWASM / WebGL\nCapacitor WebView",
            fillcolor="#1B2E4B",
            color="#60A5FA"
        ];

        detector_model [
            label="detector.onnx\nYOLO11n single connector\nbbox + box_conf",
            fillcolor="#2A1B4A",
            color="#C084FC"
        ];

        classifier_model [
            label="classifier.onnx\nEfficientNetV2-S 10-class\nlogits",
            fillcolor="#2A1B4A",
            color="#C084FC"
        ];
    }

    web_bundle -> ort_runtime;
    web_bundle -> detector_model;
    web_bundle -> classifier_model;
    class_set -> classifier_model [label="label order"];

    subgraph cluster_rev3 {
        label="Active Rev-3 Stage-0 Path";
        color="#FBBF24";
        fontcolor="#FEF3C7";
        fillcolor="#2B1F07";
        style="rounded,filled";

        camera [
            label="Camera / Image Input\nlocal only",
            fillcolor="#123524",
            color="#2DD4BF"
        ];

        detector [
            label="Detector Runner\nbox_conf gate from thresholds.json",
            fillcolor="#1B2E4B",
            color="#60A5FA"
        ];

        roi [
            label="ROI Crop\nconnector candidate",
            fillcolor="#1B2E4B",
            color="#60A5FA"
        ];

        qt [
            label="Q_t Capture Quality\nblur / glare / oblique\nROI scale / center_res\ncenter_res does not drive q_low",
            fillcolor="#3B2608",
            color="#FBBF24"
        ];

        classifier [
            label="Flat Classifier\nlogits over locked classes",
            fillcolor="#2A1B4A",
            color="#C084FC"
        ];

        temp [
            label="Temperature Calibration\nsoftmax(logits / T)",
            fillcolor="#3B2608",
            color="#FBBF24"
        ];

        support [
            label="Support Score\nlogit-energy s_ood\nlarger = more unsupported",
            fillcolor="#3B2608",
            color="#FBBF24"
        ];

        controller [
            label="Stage-0 Decision Controller\nbox -> Q_t -> support -> required-visible -> accept/margin",
            fillcolor="#3B2608",
            color="#FBBF24"
        ];

        accept [
            label="ACCEPT\nclass + calibrated probability\nmargin + trace",
            fillcolor="#064E3B",
            color="#34D399"
        ];

        abstain [
            label="ABSTAIN\nreason + guidance + trace",
            fillcolor="#4A1D1D",
            color="#F87171"
        ];
    }

    ort_runtime -> detector [label="runs"];
    detector_model -> detector [label="load"];
    classifier_model -> classifier [label="load"];
    camera -> detector;
    detector -> roi [label="bbox"];
    roi -> qt;
    roi -> classifier;
    qt -> controller [label="quality"];
    classifier -> temp [label="logits"];
    temp -> support [label="energy"];
    temp -> controller [label="calibrated probabilities"];
    support -> controller [label="s_ood"];
    controller -> accept;
    controller -> abstain;

    subgraph cluster_abstain {
        label="Rev-3 Abstention Outputs";
        color="#F87171";
        fontcolor="#FEE2E2";
        fillcolor="#2A0D0D";
        style="rounded,filled";

        no_connector [
            label="no_connector_found\nlow_box_confidence",
            fillcolor="#4A1D1D",
            color="#F87171"
        ];

        better_focus [
            label="need_better_focus\nblur / glare / low ROI scale\nor center not resolvable",
            fillcolor="#4A1D1D",
            color="#F87171"
        ];

        second_angle [
            label="need_second_angle\noblique / poor face visibility",
            fillcolor="#4A1D1D",
            color="#F87171"
        ];

        unsupported [
            label="unsupported_connector\ns_ood >= threshold",
            fillcolor="#4A1D1D",
            color="#F87171"
        ];

        ambiguous [
            label="ambiguous\nprobability or margin insufficient",
            fillcolor="#4A1D1D",
            color="#F87171"
        ];
    }

    abstain -> no_connector;
    abstain -> better_focus;
    abstain -> second_angle;
    abstain -> unsupported;
    abstain -> ambiguous;

    subgraph cluster_hardcase {
        label="Hard-Case Pool Feedback Loop";
        color="#F472B6";
        fontcolor="#FCE7F3";
        fillcolor="#2A1024";
        style="rounded,filled";

        capture [
            label="Capture Candidate\nall abstained\nsampled accepted",
            fillcolor="#302033",
            color="#F472B6"
        ];

        consent [
            label="Explicit Consent\nlocal storage only",
            fillcolor="#302033",
            color="#F472B6"
        ];

        tag [
            label="Failure Tag\nblur / poor_center\nscale_ambiguous / side_angle_needed\nfamily_confusion / gender_confusion\nout_of_support / detector_missed",
            fillcolor="#302033",
            color="#F472B6"
        ];

        export [
            label="Manual JSON Export\nbrowser/WebView only\nno automatic upload",
            fillcolor="#302033",
            color="#F472B6"
        ];

        labeling [
            label="Offline Labeling\nsparse annotations\nspecimen-aware dataset builder",
            fillcolor="#302033",
            color="#F472B6"
        ];

        retrain [
            label="Future Recalibration / Retraining\nRev 4+ refiner\nRev 5+ probes",
            fillcolor="#302033",
            color="#F472B6"
        ];
    }

    accept -> capture [label="sampled", constraint=false];
    abstain -> capture [label="all consented", constraint=false];
    capture -> consent -> tag -> export -> labeling -> retrain;
    retrain -> web_bundle [label="future bundle update", constraint=false];

    subgraph cluster_future {
        label="Future Staged Modules - Rev 5-6 Only";
        color="#94A3B8";
        fontcolor="#E2E8F0";
        fillcolor="#111827";
        style="rounded,dashed,filled";

        future_probes [
            label="Semantic Probe Stack\ncenter / ring / thread\nbody-span / axial\nnot active in Rev 3",
            fillcolor="#1F2937",
            color="#94A3B8"
        ];

        future_sprt [
            label="Sequential Evidence Only\nSPRT / Lambda_t\nRev 5+ posterior updates",
            fillcolor="#1F2937",
            color="#94A3B8"
        ];

        ood_corpus [
            label="OOD Negative Corpus\nfuture Rev-3.x+\nnot required for v1 energy gate",
            fillcolor="#1F2937",
            color="#94A3B8"
        ];
    }

    qt -> future_probes [style=dashed, label="future likelihood down-weighting", constraint=false];
    future_probes -> future_sprt [style=dashed, label="future sequential evidence"];
    capture -> ood_corpus [style=dashed, label="field hard cases", constraint=false];
    ood_corpus -> support [style=dashed, label="future corpus-trained gate", constraint=false];
}
