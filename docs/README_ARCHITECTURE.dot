digraph ConnectorIDReadmeArchitecture {
  graph [
    label="Connector ID - High-Level Architecture";
    labelloc=t;
    fontsize=24;
    fontname="Arial Bold";
    bgcolor="#f7f9fc";
    pad=0.25;
    rankdir=TB;
    ranksep=0.55;
    nodesep=0.40;
    splines=spline;
    outputorder=edgesfirst;
  ];

  node [
    shape=box;
    style="rounded,filled";
    fontname="Arial";
    fontsize=12;
    margin="0.12,0.08";
    color="#2f3b52";
    penwidth=1.5;
  ];

  edge [
    fontname="Arial";
    fontsize=10;
    color="#56677a";
    arrowsize=0.8;
    penwidth=1.5;
  ];

  camera [
    label="Camera / Gallery\nphoto, video, desktop file";
    shape=folder;
    fillcolor="#efe6ff:#fbf8ff";
    gradientangle=90;
  ];

  app [
    label="Capacitor App (production)\non-device camera + ONNX\nFlutter shell = legacy";
    shape=component;
    fillcolor="#cfe6ff:#f8fbff";
    gradientangle=90;
  ];

  api [
    label="FastAPI Service\n/predict remains compatible";
    fillcolor="#d9ecff:#f7fbff";
    gradientangle=90;
  ];

  current [
    label="Legacy Baseline\nHough crop + rembg gate\nResNet-18 classifier\n(fallback only)";
    fillcolor="#d9ecff:#f7fbff";
    gradientangle=90;
  ];

  planned [
    label="Two-Stage Pipeline (production design)\nStage 1: single-class YOLO localizer\nStage 2: flat 9-class classifier\n1.85/2.4/2.92/3.5 M+F + SMA-F";
    fillcolor="#fff1cc:#fffaf0";
    gradientangle=90;
  ];

  specs [
    label="Class Config + Spec Lookup\nconfigs/classes.yaml (the 9)\nper-class specs";
    shape=folder;
    fillcolor="#e5f7e7:#f8fff8";
    gradientangle=90;
  ];

  result [
    label="Result Card\nconnector type, confidence,\nwarnings, alternatives, specs";
    fillcolor="#fff1cc:#fffaf0";
    gradientangle=90;
  ];

  feedback [
    label="Data Feedback Loop\nContribute captures -> training data\nholdout set -> evaluation reports";
    shape=folder;
    fillcolor="#e5f7e7:#f8fff8";
    gradientangle=90;
  ];

  deploy [
    label="Deployment Targets\non-device ONNX (production)\nserver = fallback";
    shape=component;
    fillcolor="#efe6ff:#fbf8ff";
    gradientangle=90;
  ];

  { rank=same; current; planned; }

  camera -> app [label="capture"];
  app -> api [label="POST image/video"];
  api -> current [label="legacy fallback", style=dashed, color="#527aa3"];
  api -> planned [label="production path", color="#b98200"];
  current -> result [label="old fields", style=dashed];
  planned -> specs [label="9-class label", color="#b98200"];
  specs -> result [label="spec summary", color="#5a9b62"];
  result -> app [label="display + correction"];
  app -> feedback [label="confirmed/corrected captures", color="#5a9b62"];
  feedback -> planned [label="train/evaluate", style=dashed, color="#5a9b62"];
  planned -> deploy [label="approved models", style=dashed, color="#8c67aa"];
  deploy -> api [label="serve"];
}
